{
  "name": "iqb-gate",
  "version": "0.0.0",
  "private": true,
  "description": "A security gateway for IQB applications: proof-of-work page gate, ALTCHA for writes, OpenID Connect",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/protocol",
    "packages/oidc",
    "packages/gateway",
    "packages/nest",
    "packages/angular",
    "examples/demo-api",
    "examples/demo"
  ],
  "scripts": {
    "build": "npm run build -w @iqb/gate-protocol -w @iqb/gate-oidc -w @iqb/gate-gateway -w @iqb/gate-nest -w @iqb/gate-angular",
    "lint": "eslint .",
    "pretest": "npm run build -w @iqb/gate-protocol -w @iqb/gate-oidc",
    "test": "npm test -w @iqb/gate-protocol -w @iqb/gate-oidc -w @iqb/gate-gateway -w @iqb/gate-nest -w @iqb/gate-angular && npm run test:scripts",
    "test:scripts": "node --test \"scripts/test/*.spec.mjs\"",
    "pretypecheck": "npm run build -w @iqb/gate-protocol -w @iqb/gate-oidc",
    "typecheck": "npm run typecheck -w @iqb/gate-protocol -w @iqb/gate-oidc -w @iqb/gate-gateway -w @iqb/gate-nest -w @iqb/gate-angular",
    "build:examples": "npm run build -w iqb-gate-demo-api -w iqb-gate-demo",
    "version:set": "node scripts/set-version.mjs",
    "publish:check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:examples",
    "publish:dry-run": "npm run publish:check && node scripts/publish.mjs --dry-run",
    "publish:npm": "node scripts/publish.mjs --check && npm run publish:check && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
