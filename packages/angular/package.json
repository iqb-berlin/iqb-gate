{
  "name": "@iqb/gate-angular",
  "version": "0.1.0",
  "description": "The browser half of iqb-gate for Angular applications: client signals with every write, the ALTCHA challenge when the gateway asks for it",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node -e \"console.error('Publish packages/angular/dist, not the source: npm run publish:npm'); process.exit(1)\"",
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0 <22.0.0",
    "@angular/core": ">=20.0.0 <22.0.0",
    "@angular/material": ">=20.0.0 <22.0.0",
    "@angular/router": ">=20.0.0 <22.0.0",
    "rxjs": "^7.4.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@iqb/gate-protocol": "^0.1.0",
    "altcha": "3.3.0",
    "angular-auth-oidc-client": "^22.0.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/animations": "20.3.32",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.32",
    "@angular/compiler": "20.3.32",
    "@angular/compiler-cli": "20.3.32",
    "@angular/core": "20.3.32",
    "@angular/forms": "20.3.32",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.32",
    "@angular/platform-browser-dynamic": "20.3.32",
    "@angular/router": "20.3.32",
    "@golevelup/ts-jest": "0.3.8",
    "@types/jest": "30.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-preset-angular": "17.0.1",
    "ng-packagr": "20.3.2",
    "rxjs": "7.8.2",
    "zone.js": "0.15.1"
  }
}
