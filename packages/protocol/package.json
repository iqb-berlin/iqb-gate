{
  "name": "@iqb/gate-protocol",
  "version": "0.0.0",
  "description": "What the iqb-gate gateway and its client libraries agree on: headers, paths, status codes, types",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "node ../../scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/mark-commonjs.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.spec.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "vitest": "4.1.11"
  }
}
